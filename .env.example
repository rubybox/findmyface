# Copy to .env on the server; do not commit .env.
APP_BASE_URL=https://photos.example.com
APP_DOMAIN=photos.example.com
DRIVE_FOLDER_ID=YOUR_DRIVE_FOLDER_ID
PUBLIC_ACCESS=true
AUTO_INDEX=true
# Optional: leave empty to disable Analytics.
GA_MEASUREMENT_ID=
# Used only by the optional legacy login mode.
ALLOWED_EMAIL=owner@example.com
APP_PORT=8000
# Only for compose.existing-proxy.yaml
EXTERNAL_PROXY_NETWORK=edge
